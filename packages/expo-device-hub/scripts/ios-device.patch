+impl TouchSample {
+    // UniversalHID uses the digitizer's portrait coordinates, even when the
+    // display stream is rotated. Keep one orientation for the whole gesture.
+    pub fn oriented(self, orientation: InterfaceOrientation) -> Result<Self, String> {
+        use InterfaceOrientation::*;
+        normalized(self.x, self.width)?;
+        normalized(self.y, self.height)?;
+        let (x, y, width, height) = match orientation {
+            Portrait => (self.x, self.y, self.width, self.height),
+            PortraitUpsideDown => (self.width - self.x, self.height - self.y, self.width, self.height),
+            LandscapeRight => (self.height - self.y, self.x, self.height, self.width),
+            LandscapeLeft => (self.y, self.width - self.x, self.height, self.width),
+            Unknown => return Err("Cannot determine the device's screen orientation. Unlock it and retry.".into()),
+        };
+        Ok(Self { x, y, width, height, ..self })
+    }
@@ -113,0 +133,17 @@
+    fn maps_display_touches_to_the_portrait_digitizer_in_every_orientation() {
+        use InterfaceOrientation::*;
+        let point = sample(0, 100.0, 200.0);
+        for (orientation, expected) in [
+            (Portrait, (100.0, 200.0, 400.0, 800.0)),
+            (PortraitUpsideDown, (300.0, 600.0, 400.0, 800.0)),
+            (LandscapeRight, (600.0, 100.0, 800.0, 400.0)),
+            (LandscapeLeft, (200.0, 300.0, 800.0, 400.0)),
+        ] {
+            let p = point.oriented(orientation).unwrap();
+            assert_eq!((p.x, p.y, p.width, p.height), expected);
+        }
+        assert!(point.oriented(Unknown).is_err());
+        assert!(sample(0, -1.0, 0.0).oriented(LandscapeRight).is_err());
+    }
